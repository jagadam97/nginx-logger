BATCH_SIZE=50
BATCH_DELAY=15
LOG_FILE_PATH=/var/log/all_proxy_access.log

# Host directory holding Nginx Proxy Manager's /data/logs
NPM_LOG_DIR=/path/to/npm/data/logs

# nginx stub_status endpoint (leave empty to disable scraping)
STUB_STATUS_URL=
STUB_INTERVAL=10s

API_PORT=8124

# InfluxDB v2
INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
